# Copy to .env and adjust. Every line is optional.

# Folder on this machine that the app browses; phone uploads land inside it.
PHOTOS_DIR=./photos
# Database, thumbnail cache and the generated access key.
DATA_DIR=./data
PORT=8080
SERVER_NAME=darkroom
UPLOAD_FOLDER=phone
# Leave empty to generate one on first start (shown by `docker compose logs server`).
ACCESS_KEY=
# Owner of uploaded files; use the output of `id -u` and `id -g`.
PUID=1000
PGID=1000
